{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oracle Gold Campaign Attack v1",
  "type": "object",
  "required": [
    "id",
    "family",
    "family_name",
    "title",
    "question",
    "deterministic_attack",
    "success_condition",
    "hard_fail_condition",
    "theorem_prize",
    "replay_signature",
    "priority",
    "cost",
    "operators",
    "dependencies",
    "required_outputs",
    "promotion_rule",
    "gold_score"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OCG-[0-9]{3}$"
    },
    "family": {
      "type": "string"
    },
    "family_name": {
      "type": "string"
    },
    "family_scope": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "deterministic_attack": {
      "type": "string"
    },
    "success_condition": {
      "type": "string"
    },
    "hard_fail_condition": {
      "type": "string"
    },
    "theorem_prize": {
      "type": "string"
    },
    "replay_signature": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "cost": {
      "enum": [
        "low",
        "medium",
        "high",
        "very_high"
      ]
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "promotion_rule": {
      "type": "string"
    },
    "gold_score": {
      "type": "integer"
    },
    "launch_rank": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}